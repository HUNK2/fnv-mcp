{
 "name": "S1: play Hello Courier as a player",
 "plugins": ["HelloCourier.esp"],
 "steps": [
  {"wait": {"until": "GetStage HelloCourier >= 10", "timeout": 15}},
  {"expect": {"stage": "HelloCourier", "equals": 10}},
  {"expect": {"item_count": "HelloCourierToken", "equals": 0}},
  {"expect": {"item_count": "Caps001", "equals": 0}},
  {"play": {"action": "talk", "ref": "HelloCourierContactRef"}},
  {"dialogue": {"choose": ["look for them"]}},
  {"wait": {"until": "GetStage HelloCourier >= 20", "timeout": 30}},
  {"play": {"action": "goto", "ref": "HelloCourierToken1Ref"}},
  {"play": {"action": "activate", "ref": "HelloCourierToken1Ref"}},
  {"play": {"action": "goto", "ref": "HelloCourierToken2Ref"}},
  {"play": {"action": "activate", "ref": "HelloCourierToken2Ref"}},
  {"expect": {"stage": "HelloCourier", "equals": 20}},
  {"play": {"action": "goto", "ref": "HelloCourierToken3Ref"}},
  {"play": {"action": "activate", "ref": "HelloCourierToken3Ref"}},
  {"wait": {"until": "GetStage HelloCourier >= 30", "timeout": 15}},
  {"expect": {"item_count": "HelloCourierToken", "equals": 3}},
  {"play": {"action": "talk", "ref": "HelloCourierContactRef"}},
  {"dialogue": {"choose": ["three tokens"]}},
  {"wait": {"until": "GetStage HelloCourier >= 40", "timeout": 30}},
  {"expect": {"item_count": "HelloCourierToken", "equals": 0}},
  {"expect": {"item_count": "Caps001", "equals": 100}},
  {"expect": {"no_script_errors": true}},
  {"photo": {"action": "ref", "ref": "HelloCourierContactRef", "angles": ["front", "three_quarter", "side"]}}
 ]
}
