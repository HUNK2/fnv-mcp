{
 "schema": 1,
 "project_id": "hellocourier",
 "plugin": "HelloCourier.esp",
 "author": "fnv-mcp scenario S1",
 "description": "Hello Courier: a contact asks the player to find three tokens in the room and pays 100 caps for them. An NPC with its own dialogue, objectives and result scripts. Vanilla assets only.",
 "masters": [
  "FalloutNV.esm"
 ],
 "records": {
  "HelloCourierToken": {
   "type": "MISC",
   "fields": [
    {"tag": "OBND", "pack": "<6h", "values": [-4, -4, -6, 4, 4, 5]},
    {"tag": "FULL", "text": "Courier Token"},
    {"tag": "MODL", "text": "Clutter\\Junk\\TinCan01.NIF"},
    {"tag": "ICON", "text": "Interface\\Icons\\PipboyImages\\Items\\item_junk.dds"},
    {"tag": "DATA", "pack": "<if", "values": [1, 0.5]}
   ]
  },
  "HelloCourierLight": {
   "type": "LIGH",
   "radius": 700,
   "color": [255, 225, 170],
   "flags": ["dynamic"],
   "falloff": 1.0,
   "fov": 90.0,
   "fade": 1.0
  },
  "HelloCourierContact": {
   "type": "NPC_",
   "template": "VStreetSS6Traveler01",
   "fields": [
    {"tag": "FULL", "text": "Courier Contact"},
    {"tag": "SNAM", "remove": true},
    {"tag": "PKID", "remove": true}
   ]
  },
  "HelloCourierScript": {
   "type": "SCPT",
   "source": "scripts/HelloCourierScript.gek",
   "script_type": "quest"
  },
  "HelloCourier": {
   "type": "QUST",
   "fields": [
    {"tag": "SCRI", "form": "@HelloCourierScript"},
    {"tag": "FULL", "text": "Hello Courier"},
    {"tag": "DATA", "pack": "<BBBBf", "values": [1, 80, 0, 0, 0.5]},
    {"tag": "INDX", "pack": "<h", "values": [10], "append": true},
    {"tag": "INDX", "pack": "<h", "values": [20], "append": true},
    {"tag": "INDX", "pack": "<h", "values": [30], "append": true},
    {"tag": "INDX", "pack": "<h", "values": [40], "append": true},
    {"tag": "QOBJ", "s32": 10, "append": true},
    {"tag": "NNAM", "text": "Talk to the Courier Contact.", "append": true},
    {"tag": "QOBJ", "s32": 20, "append": true},
    {"tag": "NNAM", "text": "Find the three Courier Tokens.", "append": true},
    {"tag": "QOBJ", "s32": 30, "append": true},
    {"tag": "NNAM", "text": "Bring the tokens to the Courier Contact.", "append": true}
   ]
  },
  "HelloCourierAccept": {
   "type": "DIAL",
   "fields": [
    {"tag": "QSTI", "form": "@HelloCourier"},
    {"tag": "FULL", "text": "Sure, I'll look for them."},
    {"tag": "PNAM", "float": 50.0},
    {"tag": "DATA", "hex": "0000"}
   ],
   "infos": [
    {"key": "thanks", "quest": "@HelloCourier", "flags": ["goodbye"],
     "responses": [{"text": "Thank you! They're somewhere on this floor.", "emotion": "happy"}],
     "conditions": [{"function": "GetIsID", "param1": "@HelloCourierContact", "value": 1}],
     "result": "SetObjectiveCompleted HelloCourier 10 1\nSetObjectiveDisplayed HelloCourier 20 1\nSetStage HelloCourier 20"}
   ]
  },
  "HelloCourierHandIn": {
   "type": "DIAL",
   "fields": [
    {"tag": "QSTI", "form": "@HelloCourier"},
    {"tag": "FULL", "text": "Here are your three tokens."},
    {"tag": "PNAM", "float": 50.0},
    {"tag": "DATA", "hex": "0000"}
   ],
   "infos": [
    {"key": "paid", "quest": "@HelloCourier", "flags": ["goodbye"],
     "responses": [{"text": "All three! Here, a hundred caps, as promised.", "emotion": "happy"}],
     "conditions": [{"function": "GetIsID", "param1": "@HelloCourierContact", "value": 1}],
     "result": "player.RemoveItem HelloCourierToken 3\nplayer.AddItem Caps001 100\nSetObjectiveCompleted HelloCourier 30 1\nSetStage HelloCourier 40"}
   ]
  },
  "GREETING": {
   "type": "DIAL",
   "override": true,
   "infos": [
    {"key": "offer", "quest": "@HelloCourier",
     "responses": [{"text": "Courier! I dropped three tokens somewhere in this room. Would you find them for me?"}],
     "conditions": [{"function": "GetIsID", "param1": "@HelloCourierContact", "value": 1},
                    {"function": "GetStage", "param1": "@HelloCourier", "op": "<", "value": 20}],
     "choices": ["@HelloCourierAccept"]},
    {"key": "waiting", "quest": "@HelloCourier", "flags": ["goodbye"],
     "responses": ["Still looking? They can't have gone far."],
     "conditions": [{"function": "GetIsID", "param1": "@HelloCourierContact", "value": 1},
                    {"function": "GetStage", "param1": "@HelloCourier", "op": "==", "value": 20}]},
    {"key": "found", "quest": "@HelloCourier",
     "responses": ["You found them, didn't you? I can tell."],
     "conditions": [{"function": "GetIsID", "param1": "@HelloCourierContact", "value": 1},
                    {"function": "GetStage", "param1": "@HelloCourier", "op": "==", "value": 30}],
     "choices": ["@HelloCourierHandIn"]},
    {"key": "done", "quest": "@HelloCourier", "flags": ["goodbye"],
     "responses": ["Thanks again, friend."],
     "conditions": [{"function": "GetIsID", "param1": "@HelloCourierContact", "value": 1},
                    {"function": "GetStage", "param1": "@HelloCourier", "op": ">=", "value": 40}]}
   ]
  }
 },
 "cells": {
  "HelloCourierRoom": {
   "name": "Hello Courier Room",
   "lighting": {
    "ambient": [48, 44, 40],
    "directional": [24, 24, 28],
    "fog_color": [0, 0, 0],
    "fog_near": 0.0,
    "fog_far": 12000.0,
    "clip_distance": 12000.0,
    "directional_fade": 1.0,
    "fog_power": 1.0
   },
   "objects": [
    {"ref_id": "coc.marker", "base": "@COCMarkerHeading", "position": [-600, 0, 8], "rotation": [0, 0, 90]},
    {"ref_id": "light.w", "base": "@HelloCourierLight", "position": [-380, 0, 260]},
    {"ref_id": "light.e", "base": "@HelloCourierLight", "position": [380, 0, 260]},
    {"ref_id": "floor.1", "base": "@FacRmFloor01", "position": [-640, 0, 0]},
    {"ref_id": "floor.2", "base": "@FacRmFloor01", "position": [-384, 0, 0]},
    {"ref_id": "floor.3", "base": "@FacRmFloor01", "position": [-128, 0, 0]},
    {"ref_id": "floor.4", "base": "@FacRmFloor01", "position": [128, 0, 0]},
    {"ref_id": "floor.5", "base": "@FacRmFloor01", "position": [384, 0, 0]},
    {"ref_id": "floor.6", "base": "@FacRmFloor01", "position": [640, 0, 0]},
    {"ref_id": "contact", "base": "@HelloCourierContact", "position": [600, 0, 8], "rotation": [0, 0, 270], "editor_id": "HelloCourierContactRef", "persistent": true},
    {"ref_id": "token.1", "base": "@HelloCourierToken", "position": [-250, 90, 30], "editor_id": "HelloCourierToken1Ref", "persistent": true},
    {"ref_id": "token.2", "base": "@HelloCourierToken", "position": [60, -100, 30], "editor_id": "HelloCourierToken2Ref", "persistent": true},
    {"ref_id": "token.3", "base": "@HelloCourierToken", "position": [330, 110, 30], "editor_id": "HelloCourierToken3Ref", "persistent": true}
   ]
  }
 }
}
