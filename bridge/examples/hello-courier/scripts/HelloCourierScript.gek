scn HelloCourierScript

; Hello Courier: talk to the courier's contact, find three tokens, bring them back.
; Stage 10 talk, 20 find the tokens, 30 return, 40 done. The dialogue result scripts set 20 and 40.

short started

begin GameMode
	if started == 0
		set started to 1
		SetStage HelloCourier 10
		SetObjectiveDisplayed HelloCourier 10 1
	endif
	if GetStage HelloCourier == 20
		if player.GetItemCount HelloCourierToken >= 3
			SetObjectiveCompleted HelloCourier 20 1
			SetObjectiveDisplayed HelloCourier 30 1
			SetStage HelloCourier 30
		endif
	endif
end
